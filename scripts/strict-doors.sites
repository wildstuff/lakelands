crates/lakelands-backings/src/keyring.rs read serde_json::from_slice	value
crates/lakelands-backings/src/lib.rs output serde_json::from_slice	value
crates/lakelands-core/src/bundle/yaml.rs read serde_saphyr::from_str	check
crates/lakelands-core/src/bundle/yaml.rs read serde_saphyr::from_str	value
crates/lakelands-core/src/bundle/yaml.rs to serde_saphyr::from_str	written

# Types in the contract whose derived `Deserialize` buffers its input.
# buffered <path> <type> <exempt lakelands#N>
buffered crates/lakelands-api/src/error.rs Error	exempt lakelands#1804
