# Every place a door crate or the contract reads: see scripts/strict-doors.py.
# <path> <function> <entry point> <value|check|written|exempt lakelands#N>
crates/lakelands-api/src/read.rs deserialize serde_json::from_value	exempt lakelands#720
crates/lakelands-api/src/settings.rs default_value serde_json::from_str	value
crates/lakelands-server/src/http.rs forwarded serde_json::from_str	value
crates/lakelands-server/src/http.rs read_json serde_json::from_slice	value
crates/lakelands-server/src/rest.rs order serde_json::from_str	value
