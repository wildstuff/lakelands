package lakelands:data@0.22.0;

/// One open lake and its data doors: the store facade (`LakeStore`),
/// the per-type doors, proposals and ingest of the catalog (`Catalog`),
/// and the change feed (`ChangeFeed`).
///
/// A handle is bound as the crate binds it: a `lake-store` is one open
/// lake, and the `catalog` it hands out writes under one write context.
/// Every door names the principal it acts for, and the store enforces
/// that principal's grants (`docs/decisions/006-grants-not-roles.md`).
/// A host that serves guests it does not trust resolves the principal
/// itself and does not take a guest's word for its grants.
interface store {
    use types.{
        lake-id, type-name, record-key, relation-name, verb-name, proposal-id, source-id, position,
        principal, write-context, limits, verification, error, timestamp, age-report, purge-report,
        compact-report, vector-coverage, forget-report, forget-set-report, selection, remove-report,
        find, found-reply, get, record-reply, patch, write-opts, outcome,
        proposed-write, proposal-filter, proposals-reply, source-record, committed, ingest-error, ingest-opts,
        feed-filter, feed-batch, version,
    };

    /// The lake `lake`, opened by the host. Which lakes a caller may
    /// open, and how, is the host's to decide.
    open: func(lake: lake-id) -> result<lake-store, error>;

    /// One open lake, as its host holds it (`LakeStore`).
    resource lake-store {
        lake: func() -> lake-id;
        /// Whether this handle holds the lake's writer lease.
        is-writer: func() -> bool;
        /// Why a forgetting's reclaim is still owed, where the last one
        /// tried failed: the writer opened without it.
        reclaim-owed: func() -> option<string>;
        /// Why the writer's open rebuilt the projection, where it did: an
        /// older build laid it out.
        rebuilt-at-open: func() -> option<string>;
        limits: func() -> limits;
        /// The lake's last position.
        head: func() -> result<position, error>;
        /// The head once it is at `at` or past it, waiting at most
        /// `within-millis` for it; past the bound, unavailable.
        reaches: func(at: position, within-millis: u64) -> result<position, error>;
        /// The doors of this lake, writing under `context`.
        catalog: func(context: write-context) -> catalog;
        /// The change feed: the log filtered by kind
        /// (`docs/decisions/004-the-change-feed-is-the-log.md`).
        feed: func() -> change-feed;
        /// Check the hash chain between two positions.
        verify: func(%from: option<position>, through: option<position>) -> result<verification, error>;
        /// Delete the projection and fold the log again.
        rebuild: func() -> result<position, error>;
        /// Withhold a record from principals without the `restricted`
        /// grant (a retention hold).
        restrict: func(%type: type-name, key: record-key, reason: string) -> result<position, error>;
        unrestrict: func(%type: type-name, key: record-key) -> result<position, error>;
        /// Run every aging rule once for `today`, a date at UTC midnight,
        /// and answer what it moved.
        age: func(today: timestamp) -> result<age-report, error>;
        /// Retire, in one append, every live record the source brought in,
        /// into the one type named where one is; a co-owned record refuses
        /// the whole purge. With a preflight's id, refused unless that
        /// report is of this purge at this head.
        purge-source: func(source: source-id, %type: option<type-name>, report-id: option<string>) -> result<purge-report, error>;
        /// What `purge-source` would do, appending nothing.
        purge-preflight: func(source: source-id, %type: option<type-name>) -> result<purge-report, error>;
        /// What `upsert` of the patch by `who`, through the doors of
        /// `context`, would answer, appending nothing: ok for a write that
        /// would land, else the refusal it would give, a broken constraint
        /// among them. The host's.
        upsert-preflight: func(who: principal, context: write-context, %type: type-name, key: record-key, patch: patch, expected: option<version>) -> result<_, error>;
        /// Forget a source: its keys destroyed, every value it sealed
        /// erased at every position, the storage reclaimed, in one act
        /// under the writer's lock. With a preflight's id, refused unless
        /// that report is of this source at this head.
        forget-source: func(source: source-id, report-id: option<string>) -> result<forget-report, error>;
        /// What `forget-source` would do, appending nothing, with the time
        /// it is expected to hold the writer's lock.
        forget-preflight: func(source: source-id) -> result<forget-report, error>;
        /// Forget several sources in one act: one `source-forgotten` for
        /// each, one rebuild and one reclaim under one hold of the
        /// writer. A set empty, naming a source twice or one the log
        /// holds no event of is refused whole. With a preflight's id,
        /// refused unless that report is of this set at this head.
        forget-sources: func(sources: list<source-id>, report-id: option<string>) -> result<forget-set-report, error>;
        /// What `forget-sources` would do, appending nothing, with the
        /// time the one act is expected to hold the writer's lock.
        forget-sources-preflight: func(sources: list<source-id>) -> result<forget-set-report, error>;
        /// Take back part of a source: each value a selected event of it
        /// wrote erased at every position, the records the source made
        /// left holding nothing of another hand retired, the storage
        /// reclaimed, in one act under the writer's lock; the versions of
        /// its key whose values it all selects are destroyed. With
        /// `require-shredded`, refused while a value of an erasable field
        /// would be redacted only. With a preflight's id, refused unless
        /// that report is of this removal at this head.
        remove-values: func(source: source-id, selection: selection, require-shredded: bool, report-id: option<string>) -> result<remove-report, error>;
        /// What `remove-values` would do, appending nothing, with the time
        /// it is expected to hold the writer's lock.
        remove-values-preflight: func(source: source-id, selection: selection) -> result<remove-report, error>;
        /// Give back the storage the projection no longer uses; appends
        /// nothing and changes no answer.
        compact: func() -> result<compact-report, error>;
        /// The last position, no later than the head, whose event's
        /// known-at is at or before the instant; none before the first.
        position-at: func(known-at: timestamp) -> result<option<position>, error>;
        /// For each embedding field of a type, at the head: records with a
        /// vector, and those with text to embed but none.
        vector-coverage: func(%type: type-name) -> result<list<vector-coverage>, error>;
        /// Seal the active segment and append a checkpoint.
        checkpoint: func() -> result<position, error>;
        /// Release the lease and close the lake.
        close: func() -> result<_, error>;
    }

    /// The doors of one lake (`Catalog`). The pattern query and search are
    /// in `query`, the schema doors in `schema`; both take this handle.
    resource catalog {
        lake: func() -> lake-id;
        find: func(who: principal, %type: type-name, find: find) -> result<found-reply, error>;
        get: func(who: principal, %type: type-name, get: get) -> result<record-reply, error>;
        upsert: func(who: principal, %type: type-name, key: record-key, patch: patch, opts: write-opts) -> result<outcome, error>;
        retire: func(who: principal, %type: type-name, key: record-key, opts: write-opts) -> result<outcome, error>;
        /// Write the link over a relation carried by link records, or
        /// change its fields; remove it
        /// (`docs/decisions/035-a-link-is-a-record.md`).
        link: func(who: principal, %type: type-name, key: record-key, relation: relation-name, to: record-key, fields: patch, opts: write-opts) -> result<outcome, error>;
        unlink: func(who: principal, %type: type-name, key: record-key, relation: relation-name, to: record-key, opts: write-opts) -> result<outcome, error>;
        /// Call a declared verb, on a record by its key or, for a verb
        /// declared on its type, with none; it runs or is proposed by its
        /// declared risk (`docs/decisions/013-verbs-run-by-declared-risk.md`).
        call: func(who: principal, verb: verb-name, key: option<record-key>, payload: patch, opts: write-opts) -> result<outcome, error>;
        propose: func(who: principal, write: proposed-write, why: string) -> result<outcome, error>;
        accept: func(who: principal, proposal: proposal-id) -> result<outcome, error>;
        /// Accept a proposed change to the ontology against the plan of
        /// its change made now.
        accept-planned: func(who: principal, proposal: proposal-id, plan-id: string) -> result<outcome, error>;
        reject: func(who: principal, proposal: proposal-id, reason: string) -> result<outcome, error>;
        proposals: func(who: principal, filter: proposal-filter) -> result<proposals-reply, error>;
        /// Feed the lake the records of one delivery from a source, each
        /// record in another where it names its own. The crate takes a
        /// stream; here the delivery is a list, and the answer lists
        /// every commit window it was written in.
        ingest: func(who: principal, source: source-id, records: list<source-record>) -> result<list<committed>, ingest-error>;
        /// `ingest` in the delivery `opts` names.
        ingest-with: func(who: principal, source: source-id, opts: ingest-opts, records: list<source-record>) -> result<list<committed>, ingest-error>;
    }

    /// The change feed (`ChangeFeed`): the consumer keeps its own
    /// position; `ack` is for feeds that relay elsewhere.
    resource change-feed {
        poll: func(%from: position, filter: feed-filter, limit: u32) -> result<feed-batch, error>;
        ack: func(consumer: string, through: position) -> result<_, error>;
        /// The head once the log is past `after`, or once `within-millis`
        /// have passed; never past the head `poll` reads.
        wait: func(after: position, within-millis: u64) -> result<position, error>;
    }
}
