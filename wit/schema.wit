package lakelands:data@0.20.0;

/// The lake's map: describing it and changing it. A bundle is declared
/// whole with `apply`; a shape change goes through `migrate` and its
/// preflight report (`docs/decisions/027-shape-changes-are-declared-or-migrated.md`).
interface schema {
    use types.{
        principal, read-at, type-name, lake-description-reply, type-description-reply,
        declaration, field-decl, migration, migration-report-reply, outcome, error,
        value-type-migration, value-type-report-reply, recomputed, change, plan-reply,
    };
    use store.{catalog};

    describe: func(catalog: borrow<catalog>, who: principal, at: read-at) -> result<lake-description-reply, error>;
    describe-type: func(catalog: borrow<catalog>, who: principal, %type: type-name, at: read-at) -> result<type-description-reply, error>;
    declare: func(catalog: borrow<catalog>, who: principal, declaration: declaration) -> result<outcome, error>;
    apply: func(catalog: borrow<catalog>, who: principal, declarations: list<declaration>) -> result<outcome, error>;
    add-field: func(catalog: borrow<catalog>, who: principal, %type: type-name, field: field-decl) -> result<outcome, error>;
    /// Compute again what a declaration in force computes.
    recompute: func(catalog: borrow<catalog>, who: principal, what: recomputed) -> result<outcome, error>;
    /// The fail-closed preflight: what the migration would convert, what
    /// it drops, and whether it is lossless. Nothing is written.
    migrate: func(catalog: borrow<catalog>, who: principal, migration: migration) -> result<migration-report-reply, error>;
    /// Apply a migration against the report `migrate` answered.
    migrate-apply: func(catalog: borrow<catalog>, who: principal, migration: migration, report-id: string) -> result<outcome, error>;
    /// The preflight of a value type's migration: every value stored under
    /// it, renamed as the migration renames it, checked against the new
    /// declaration. Nothing is written.
    migrate-value-type: func(catalog: borrow<catalog>, who: principal, migration: value-type-migration) -> result<value-type-report-reply, error>;
    /// Put a value type's migration in force against the report
    /// `migrate-value-type` answered.
    migrate-value-type-apply: func(catalog: borrow<catalog>, who: principal, migration: value-type-migration, report-id: string) -> result<outcome, error>;
    /// What a change to the ontology would do, before it does it: its
    /// plan, on the act's own path. Nothing is written
    /// (`docs/decisions/062-a-change-plans-before-it-acts.md`).
    plan: func(catalog: borrow<catalog>, who: principal, change: change) -> result<plan-reply, error>;
    /// Make a change against the plan `plan` answered.
    enact: func(catalog: borrow<catalog>, who: principal, change: change, plan-id: string) -> result<outcome, error>;
}
