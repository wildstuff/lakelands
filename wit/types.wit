package lakelands:data@0.15.1;

/// The types every interface of the package shares: the contract of
/// `lakelands-api`, type for type.
///
/// The Rust crate is the source and this package mirrors it; a test in
/// `lakelands-api` (`tests/wit.rs`) fails when the two drift apart. Where
/// the component model cannot say what the crate says, one rule applies
/// everywhere:
///
/// - A JSON value (a field's value, a verb's output, a function's
///   configuration) is `json`: the value's JSON text, as the contract
///   would serialise it.
/// - The typed form of an expression is recursive, and a WIT type cannot
///   be; a condition is its text form, or its typed form as `json`.
/// - A map is a list of named entries, in the map's order.
/// - A generic reply (`Reply<T>` in the crate) is one record per `T`:
///   `position` and `data`, named `<t>-reply`.
/// - A stream is a list: `ingest` takes the records of one delivery and
///   answers every commit window of it.
///
/// Names are the contract's, in kebab-case; a name that is a WIT keyword
/// (`type`, `record`, `from`) is written with `%`.
interface types {
    // ------------------------------------------------------------------
    // Identifiers and time
    // ------------------------------------------------------------------

    /// A JSON value, as its JSON text.
    type json = string;
    /// A UTC instant in the one form of `docs/log-format.md` §1.3.
    type timestamp = string;
    /// The log coordinate every reply carries (`docs/glossary.md`).
    type position = u64;
    /// A record's compare-and-set token.
    type version = u64;
    type lake-id = string;
    type type-name = string;
    type field-name = string;
    type record-key = string;
    type relation-name = string;
    type verb-name = string;
    type trigger-name = string;
    type constraint-name = string;
    type param-name = string;
    type value-type-name = string;
    type source-id = string;
    type proposal-id = string;
    type idempotency-key = string;
    /// One delivery of a source: the caller's id, or the store's `d<position>`.
    type delivery-id = string;
    /// A page token of a list-shaped read, bound to its first page's
    /// position and the clock that page read.
    type cursor = string;
    /// A SHA-256 digest, as 64 lower-case hex digits.
    type digest = string;

    /// The two time axes of a read: the position it is pinned at
    /// (`as-of`), and business time (`valid-at`). The read's `now()` is
    /// `valid-at`, else as of a position the time its event was written,
    /// else the time of the read.
    record read-at {
        as-of: option<position>,
        valid-at: option<timestamp>,
    }

    // ------------------------------------------------------------------
    // Principals
    // ------------------------------------------------------------------

    enum principal-kind { human, agent, service, system }

    enum access { none, masked, read, write, write-only }

    /// A field's access, one entry of a type's grants.
    record field-access {
        field: field-name,
        access: access,
    }

    /// The grants a principal holds on one type.
    record type-grants {
        %type: type-name,
        default: option<access>,
        fields: list<field-access>,
        /// Only the records whose fields hold these values are the
        /// principal's to read; it writes nothing that reaches the type.
        only: list<field-value>,
    }

    record grants {
        default: access,
        types: list<type-grants>,
        review: bool,
        schema: bool,
        ingest: bool,
        restricted: bool,
    }

    /// Who is calling, with the grants the store enforces
    /// (`docs/decisions/006-grants-not-roles.md`).
    record principal {
        kind: principal-kind,
        id: string,
        lake: lake-id,
        grants: grants,
    }

    enum write-origin { direct, reactive, scheduled }

    record write-context {
        origin: write-origin,
        depth: u32,
        /// The position the write follows from, as the host names it; it
        /// lands in the envelope's `cause` of the write's own events.
        cause: option<position>,
    }

    // ------------------------------------------------------------------
    // Expressions
    // ------------------------------------------------------------------

    /// A condition in the one expression grammar
    /// (`docs/decisions/017-one-expression-grammar.md`).
    variant condition {
        /// The text form, as a caller writes it.
        text(string),
        /// The typed form (`docs/log-format.md` Appendix B), as JSON.
        typed(json),
    }

    // ------------------------------------------------------------------
    // Ontology
    // ------------------------------------------------------------------

    enum storage-kind {
        text, number, decimal, boolean, date-time, bytes, json, reference, vector, geo, date,
    }

    record field-type {
        kind: storage-kind,
        value-type: option<value-type-name>,
        target: option<type-name>,
        dimensions: option<u32>,
    }

    enum authority { authored, source, shared, derived, verb }

    /// Who retires a type's records: its authors through `retire`, or
    /// only its verbs whose effect is `retire`.
    enum retired-by { authors, verbs }

    enum on-input-change { keep, clear }

    /// When a computed field is computed: by the fold at a write, its value
    /// stored; or at every read, from the record as stored and the read's
    /// clock, never stored.
    enum computed-at { write, read }

    record field-decl {
        name: field-name,
        %type: field-type,
        required: bool,
        authority: authority,
        derived: option<condition>,
        function: option<string>,
        computed-at: option<computed-at>,
        depends-on: list<field-name>,
        on-input-change: on-input-change,
        /// The value the field takes when its record comes to exist and
        /// the creating write gives it none; on an authored field of a
        /// type's own alone.
        initial: option<json>,
        sensitive: bool,
        searchable: bool,
        /// Whether a source's values are sealed under its key.
        erasable: bool,
        description: option<string>,
        label: option<string>,
        embed: option<embed-decl>,
        /// The host's own marks, by namespaced key (`acme.icon`), each a
        /// JSON value; Lakelands never reads them.
        annotations: list<tuple<string, json>>,
    }

    /// An input of a function: a field's declaration, with `type` left out
    /// of an input a type binds as a field of any kind.
    record function-input {
        name: field-name,
        /// Left out of an input of any kind.
        %type: option<field-type>,
        required: bool,
        authority: authority,
        derived: option<condition>,
        function: option<string>,
        computed-at: option<computed-at>,
        depends-on: list<field-name>,
        on-input-change: on-input-change,
        /// The value the field takes when its record comes to exist and
        /// the creating write gives it none; on an authored field of a
        /// type's own alone.
        initial: option<json>,
        sensitive: bool,
        searchable: bool,
        /// Whether a source's values are sealed under its key.
        erasable: bool,
        description: option<string>,
        label: option<string>,
        embed: option<embed-decl>,
        /// The host's own marks, by namespaced key (`acme.icon`), each a
        /// JSON value; Lakelands never reads them.
        annotations: list<tuple<string, json>>,
    }

    /// What a vector field is the embedding of: text fields of the same
    /// record, joined in order with one blank line, and the model.
    record embed-decl {
        %from: list<field-name>,
        model: string,
    }

    enum cardinality { one-to-one, one-to-many, many-to-one, many-to-many }

    /// One pair of a derived relation's match: a field of the owner and a
    /// field of the target, of the same kind.
    record match-pair {
        %from: field-name,
        to: field-name,
    }

    /// What connects a derived relation's records: every pair holds the
    /// same non-null value on both sides, and `where`, if given, holds over
    /// `from.<field>` (the owner's record) and `to.<field>` (the target's).
    record derived {
        %match: list<match-pair>,
        where: option<condition>,
    }

    record relation-decl {
        name: relation-name,
        target: type-name,
        cardinality: cardinality,
        inverse: option<relation-name>,
        via: option<field-name>,
        fields: list<field-decl>,
        /// Who writes the links, for a relation carried by link records.
        authority: authority,
        description: option<string>,
        /// The host's own marks, by namespaced key (`acme.icon`), each a
        /// JSON value; Lakelands never reads them.
        annotations: list<tuple<string, json>>,
        /// Instead of a carrier: the fields whose values connect (044).
        derived: option<derived>,
    }

    record measure {
        name: field-name,
        expr: condition,
    }

    /// A parameter of a view: a value every read of it binds.
    record view-param {
        name: param-name,
        kind: storage-kind,
    }

    record view-decl {
        source: type-name,
        params: list<view-param>,
        where: option<condition>,
        group-by: list<field-name>,
        measures: list<measure>,
        /// Further sources merged on the view's key.
        merge: list<view-source>,
    }

    /// A further source of a view, grouped by its own fields in the
    /// view's key order.
    record view-source {
        source: type-name,
        where: option<condition>,
        group-by: list<field-name>,
        measures: list<measure>,
    }

    record type-decl {
        name: type-name,
        key: list<field-name>,
        fields: list<field-decl>,
        relations: list<relation-decl>,
        view: option<view-decl>,
        valid-from: option<field-name>,
        valid-to: option<field-name>,
        language: option<string>,
        field-meta: bool,
        /// Whether a source writes each of its records once.
        insert-only: bool,
        /// Who retires its records: its authors, or only its verbs.
        retired-by: retired-by,
        description: option<string>,
        label: option<string>,
        /// The host's own marks, by namespaced key (`acme.icon`), each a
        /// JSON value; Lakelands never reads them.
        annotations: list<tuple<string, json>>,
        /// What every record of the type holds, judged at every write door.
        constraints: list<constraint-decl>,
    }

    /// What `ingest` does with a record that breaks a constraint.
    enum at-ingest { refuse, admit }

    /// A condition over a record's own fields that every write moving a
    /// field it reads leaves true.
    record constraint-decl {
        name: constraint-name,
        holds: condition,
        description: option<string>,
        at-ingest: at-ingest,
    }

    record value-type-decl {
        name: value-type-name,
        kind: storage-kind,
        constraint: option<condition>,
        one-of: list<string>,
        format: option<string>,
        scale: option<u32>,
        description: option<string>,
        /// The host's own marks, by namespaced key (`acme.unit`), each a
        /// JSON value; Lakelands never reads them.
        annotations: list<tuple<string, json>>,
    }

    enum risk { low, medium, high }

    record assignment {
        field: field-name,
        value: condition,
    }

    /// What a verb does: writes to its record, reaches outside the lake
    /// through the named executor, or retires its record.
    variant verb-effect {
        write(list<assignment>),
        external(string),
        retire,
    }

    /// What a verb is called on: one record of its type, or the type,
    /// with no key.
    enum verb-scope { %record, %type }

    record verb-decl {
        name: verb-name,
        on: type-name,
        scope: verb-scope,
        payload: list<field-decl>,
        risk: risk,
        requires: option<condition>,
        effect: verb-effect,
        description: option<string>,
    }

    record trigger-decl {
        name: trigger-name,
        on: type-name,
        when: option<condition>,
        description: option<string>,
        /// How deep a reaction naming this trigger's firing as its cause
        /// may be: a write at this depth or deeper drops the firing
        /// (the log's `trigger_dropped`) instead; at most the lake's ceiling.
        max-depth: option<u32>,
        /// Whether a field or `previous(f)` its `when` reads absent or
        /// null fails the guard as a whole.
        when-strict: bool,
        /// The kinds of change that fire it; every kind when none.
        on-changes: option<list<change-kind>>,
    }

    /// What kind of change fired a trigger.
    enum change-kind {
        upserted,
        ingested,
        retired,
        forgotten,
        purged,
        recomputed,
    }

    record object-set-decl {
        name: string,
        of: type-name,
        where: condition,
        description: option<string>,
    }

    record function-decl {
        name: string,
        backing: string,
        inputs: list<function-input>,
        expr: option<condition>,
        config: option<json>,
        description: option<string>,
        /// Above `low`, a call is proposed and made only when accepted.
        risk: option<risk>,
    }

    /// A host's own setting: every write of its key is judged as a write
    /// of a field of its type, and its group is what a grant's `only` on
    /// `sys.setting` names.
    record setting-decl {
        key: string,
        %type: field-type,
        unit: option<string>,
        description: option<string>,
        group: option<string>,
    }

    variant declaration {
        %type(type-decl),
        value-type(value-type-decl),
        verb(verb-decl),
        trigger(trigger-decl),
        object-set(object-set-decl),
        function(function-decl),
        setting(setting-decl),
        withdraw(withdrawal),
    }

    /// A trigger, a verb, an object set or a function taken out of force
    /// from the withdrawal's position on; a read as of before still sees it.
    record withdrawal {
        kind: declaration-kind,
        name: string,
    }

    /// What `recompute` names.
    variant recomputed {
        function(string),
        %type(type-name),
    }

    record migration {
        to: type-decl,
        renames: list<tuple<field-name, field-name>>,
        /// Relations renamed, old name to new name: each keeps its edges.
        relation-renames: list<tuple<relation-name, relation-name>>,
        /// Fields whose `initial` each live record without a value takes.
        fill: list<field-name>,
    }

    /// A value type's migration: its new declaration and the values it
    /// renames in every stored record, old to new.
    record value-type-migration {
        to: value-type-decl,
        renames: list<tuple<string, string>>,
    }

    /// How a relation's edges are carried.
    enum carrier {
        via,
        links,
        derived,
    }

    /// A declaration a migration declares again under a link type's new name.
    record carried {
        kind: string,
        name: string,
    }

    /// One member a migration's `to` states otherwise than the declaration
    /// in force: of the type, a field, a relation or a link field.
    record restated {
        field: option<field-name>,
        member: string,
        was: json,
        to: json,
    }

    /// One relation a migration renames, in its preflight's report.
    record relation-rename {
        %from: relation-name,
        to: relation-name,
        carrier: carrier,
        links: u64,
    }

    /// The live records a migration fills a field's `initial` into.
    record field-fill {
        field: field-name,
        records: u64,
        sample-keys: list<record-key>,
    }

    record breach {
        %type: type-name,
        constraint: constraint-name,
        records: u64,
        sample-keys: list<record-key>,
    }

    /// The live records a change would leave whose reference names no
    /// live record (`docs/decisions/062-a-change-plans-before-it-acts.md`).
    record unlive {
        field: field-name,
        records: u64,
        sample-keys: list<record-key>,
    }

    record field-conversion {
        field: field-name,
        %from: field-type,
        to: field-type,
        convertible: u64,
        not-convertible: u64,
        sample-keys: list<record-key>,
    }

    record migration-report {
        /// Empty in an answer to a reader who may not see the type.
        %type: type-name,
        from-schema-hash: string,
        to-schema-hash: string,
        records-scanned: u64,
        fields: list<field-conversion>,
        /// Each removed field or relation, with the records or links
        /// whose values the apply discards.
        dropped: list<tuple<field-name, u64>>,
        relations: list<relation-rename>,
        carried: list<carried>,
        rekeyed: list<rekeyed>,
        references: list<reference-rewrite>,
        sample-collisions: list<record-ref>,
        restated: list<restated>,
        filled: list<field-fill>,
        /// Per constraint, the live records the migration would leave
        /// breaking it.
        breaches: list<breach>,
        /// The live records the change computes again; none where a
        /// declaration computes every record again and nothing is judged.
        recomputed: option<u64>,
        /// Per reference field the change may move, the live records it
        /// would leave naming no live record.
        unlive: list<unlive>,
        /// Every kept value converts, every moved record gets a key and no
        /// record breaks a constraint that refuses; it says nothing of what
        /// `dropped` removes.
        lossless: bool,
        report-id: string,
        /// The report holds more than its reader is shown.
        more: bool,
    }

    /// What a re-key does to one type's records.
    record rekeyed {
        %type: type-name,
        records: u64,
        collisions: u64,
        missing: u64,
    }

    /// The values of one reference field a re-key rewrites.
    record reference-rewrite {
        %type: type-name,
        field: field-name,
        values: u64,
    }

    // ------------------------------------------------------------------
    // Records
    // ------------------------------------------------------------------

    /// `initial`: the field's declared initial value, filled when the
    /// record came to exist.
    enum origin { source, authored, derived, system, initial }

    /// Where values read from another lake's log came from: that lake and
    /// the position of the event there whose state they are.
    record upstream {
        lake: lake-id,
        position: position,
    }

    /// A field's provenance (`docs/decisions/010-provenance-per-field.md`).
    record field-meta {
        origin: origin,
        known-at: timestamp,
        seen-at: option<timestamp>,
        position: position,
        writer: string,
        source: option<source-id>,
        procedure-version: option<string>,
        /// For a value read from another lake's log: that lake and
        /// position.
        upstream: option<upstream>,
        /// For a field a function computes that holds no value because
        /// its backing failed: why.
        error: option<string>,
        /// For a value of a source that was forgotten: it was written,
        /// and is erased for every reader.
        erased: bool,
    }

    /// One field and its value.
    record field-value {
        field: field-name,
        value: json,
    }

    /// One field and its provenance.
    record field-meta-entry {
        field: field-name,
        meta: field-meta,
    }

    /// A sparse patch: each entry sets a field, the JSON `null` clears
    /// it, an absent field is unchanged
    /// (`docs/decisions/012-writes-touch-only-their-fields.md`).
    type patch = list<field-value>;

    /// A record as a principal reads it.
    record %record {
        %type: type-name,
        key: record-key,
        version: version,
        fields: list<field-value>,
        masked: list<field-name>,
        meta: list<field-meta-entry>,
    }

    /// A record as a source delivers it to `ingest`.
    record source-record {
        %type: type-name,
        key: record-key,
        fields: patch,
        seen-at: option<timestamp>,
        /// When the values were read from another lake's log (a
        /// mirror's): that lake and the position of the state they
        /// reflect.
        upstream: option<upstream>,
        /// The source this record comes from, where it is not the
        /// call's.
        source: option<source-id>,
    }

    // ------------------------------------------------------------------
    // Reads
    // ------------------------------------------------------------------

    enum direction { asc, desc }

    enum order-by { value, known-at, seen-at, latest }

    record order {
        field: field-name,
        by: order-by,
        dir: direction,
    }

    enum agg-func { count, sum, min, max, avg }

    record agg-measure {
        name: field-name,
        %func: agg-func,
        field: option<field-name>,
    }

    record aggregate {
        measures: list<agg-measure>,
        group-by: list<group-key>,
    }

    /// One key of an aggregate's grouping: a field's value, or a named
    /// expression's value per record, answered under its name.
    variant group-key {
        field(field-name),
        named(named-group),
    }

    /// A group key computed by an expression, answered under `name`.
    record named-group {
        name: field-name,
        expr: condition,
    }

    record find {
        where: option<condition>,
        order-by: list<order>,
        limit: option<u32>,
        cursor: option<cursor>,
        after: option<after-row>,
        /// Rows of the order skipped before the page: at most the lake's
        /// `max-offset`; refused with `cursor`, `after` or `aggregate`.
        offset: option<u32>,
        /// Answer how many records match, at the answer's position.
        total: bool,
        /// Answer how many retired records match, at the same position.
        retired: bool,
        aggregate: option<aggregate>,
        with-meta: bool,
        /// The values bound to a view's parameters, each as JSON.
        params: list<tuple<param-name, json>>,
        at: read-at,
    }

    /// A sort position `find` resumes strictly after: the row's values
    /// for the `order-by` keys, in order (`null` where it has none), and
    /// its key.
    record after-row {
        values: list<json>,
        key: record-key,
    }

    record group {
        by: list<field-value>,
        values: list<field-value>,
    }

    record records-page {
        rows: list<%record>,
        next-cursor: option<cursor>,
        /// How many records match, when `total` asked for it.
        total: option<u64>,
        /// How many retired records match, when `retired` asked for it.
        retired: option<u64>,
    }

    variant found {
        records(records-page),
        groups(list<group>),
    }

    record get {
        key: record-key,
        with-meta: bool,
        params: list<tuple<param-name, json>>,
        at: read-at,
    }

    // ------------------------------------------------------------------
    // Writes and proposals
    // ------------------------------------------------------------------

    record write-opts {
        expected-version: option<version>,
        idempotency-key: option<idempotency-key>,
    }

    /// Options an `ingest` takes.
    record ingest-opts {
        delivery: option<delivery-id>,
    }

    record applied {
        position: position,
        version: option<version>,
        /// An external verb's recorded output, the error form included.
        output: option<json>,
        /// What the write set off: the last position of it, when after
        /// `position`, and the triggers fired and object sets joined and
        /// left that `describe` lists to the caller. For a set's
        /// declaration, `joined` and `left` name the set, once, when it
        /// took records in or let them go.
        through: option<position>,
        fired: list<trigger-name>,
        joined: list<string>,
        left: list<string>,
        /// For a migration: each field it renamed, old name and new, as
        /// the one answered may know of them.
        renamed: list<tuple<field-name, field-name>>,
        /// For `declare` and `apply`: each declaration sent, in the order
        /// sent, as it stands in force after the call.
        declared: list<in-force>,
        /// For a change to the ontology: the plan that applied.
        plan: option<plan>,
    }

    /// A declaration's kind. A later kind is an addition.
    enum declaration-kind { %type, value-type, verb, trigger, object-set, function, setting }

    /// A declaration sent to `declare` or `apply`, as it stands in force
    /// after the call: its version, the position it has stood from, and
    /// whether this call appended it.
    record in-force {
        kind: declaration-kind,
        name: string,
        version: u32,
        since: position,
        appended: bool,
    }

    record proposed {
        position: position,
        proposal: proposal-id,
        why: string,
        /// For a proposed change to the ontology: its plan.
        plan: option<plan>,
    }

    /// What every write answers (`docs/decisions/015-errors-are-a-closed-set-writes-answer-an-outcome.md`).
    variant outcome {
        applied(applied),
        proposed(proposed),
    }

    record upsert-write {
        %type: type-name,
        key: record-key,
        patch: patch,
        opts: write-opts,
    }

    record retire-write {
        %type: type-name,
        key: record-key,
        opts: write-opts,
    }

    record call-write {
        verb: verb-name,
        key: option<record-key>,
        payload: patch,
        opts: write-opts,
    }

    /// Declarations proposed together, as `apply` would apply them.
    record declare-write {
        declarations: list<declaration>,
        /// Their plan when they were proposed; the store answers it.
        plan: option<plan>,
    }

    /// A migration proposed, with the report its preflight answered then.
    record migrate-write {
        migration: migration,
        report: migration-report,
    }

    /// A value type's migration and the report its preflight answered
    /// when it was proposed.
    record migrate-value-type-write {
        to: value-type-decl,
        renames: list<tuple<string, string>>,
        report: value-type-report,
    }

    /// One record's call of a function above `low` risk, as the store
    /// proposes it.
    record compute-write {
        %type: type-name,
        key: record-key,
        field: field-name,
        function: string,
        inputs: option<json>,
        /// The call's digest on its record, which keys its output: a
        /// decision holds for its record alone.
        input: digest,
    }

    /// The calls a declaration or `recompute` makes due over a type, of a
    /// function above `low` risk, proposed as one.
    record compute-sweep-write {
        %type: type-name,
        function: string,
        count: u64,
        first: list<record-key>,
    }

    variant proposed-write {
        upsert(upsert-write),
        retire(retire-write),
        call(call-write),
        declare(declare-write),
        migrate(migrate-write),
        migrate-value-type(migrate-value-type-write),
        compute(compute-write),
        compute-sweep(compute-sweep-write),
    }

    enum proposal-kind { upsert, retire, call, declare, migrate, migrate-value-type, compute }

    enum proposal-state { pending, accepted, rejected }

    record proposal {
        id: proposal-id,
        position: position,
        proposer: string,
        proposed-at: timestamp,
        /// As far as its reader may see it; absent when it may see nothing.
        write: option<proposed-write>,
        why: string,
        state: proposal-state,
        decided-by: option<string>,
        reason: option<string>,
        /// The proposal holds more than its reader is shown.
        more: bool,
    }

    record proposal-filter {
        state: option<proposal-state>,
        %type: option<type-name>,
        kind: option<proposal-kind>,
        limit: option<u32>,
        order-by: list<order>,
        cursor: option<cursor>,
        at: read-at,
    }

    /// One commit window of an ingest.
    record committed {
        position: position,
        records: u32,
        duplicates: u32,
        delivery: option<delivery-id>,
    }

    // ------------------------------------------------------------------
    // The pattern query and search
    // ------------------------------------------------------------------

    enum walk { out, in, both }

    record depth {
        min: u32,
        max: u32,
    }

    record lexical-search {
        text: string,
        fields: option<list<field-name>>,
    }

    record vector-term {
        field: field-name,
        vector: list<f32>,
        weight: option<f64>,
        /// The model that made the vector, if the caller names it.
        model: option<string>,
    }

    record vector-search {
        field: field-name,
        vector: list<f32>,
        weight: option<f64>,
        also: list<vector-term>,
        /// The model that made the vector, if the caller names it.
        model: option<string>,
    }

    record hybrid-search {
        text: string,
        field: field-name,
        vector: option<list<f32>>,
        fields: option<list<field-name>>,
        weight: option<f64>,
        text-weight: option<f64>,
        /// The model that made the vector, if the caller names it.
        model: option<string>,
    }

    variant search-mode {
        lexical(lexical-search),
        vector(vector-search),
        hybrid(hybrid-search),
    }

    record start {
        /// Left out only by `components`, which then grows from every
        /// linked record.
        %type: option<type-name>,
        key: option<record-key>,
        where: option<condition>,
        search: option<search-mode>,
        params: list<tuple<param-name, json>>,
        /// The name a row binds the start's record under; its type's name
        /// when none.
        %as: option<string>,
    }

    record step {
        relation: relation-name,
        walk: walk,
        %type: option<type-name>,
        where: option<condition>,
        depth: depth,
        /// The name a row binds the reached record under; its type's name
        /// when none.
        %as: option<string>,
    }

    variant projection {
        /// Bindings per step; the named fields, or all when empty.
        rows(list<string>),
        graph,
        aggregate(aggregate),
        /// Each start record's links over the steps' relations.
        degree,
        /// The weak components the start records are in.
        components,
        /// What each step reaches, each record at the first step.
        reach,
    }

    record pattern {
        start: start,
        steps: list<step>,
        to: option<tuple<type-name, record-key>>,
        project: projection,
        order-by: list<order>,
        limit: option<u32>,
        cursor: option<cursor>,
        at: read-at,
    }

    record edge {
        %from: tuple<type-name, record-key>,
        relation: relation-name,
        to: tuple<type-name, record-key>,
        fields: list<field-value>,
    }

    record rows-page {
        /// One entry per row: the row's bindings by name.
        rows: list<list<field-value>>,
        next-cursor: option<cursor>,
    }

    record graph {
        nodes: list<%record>,
        /// Each node's depth, in the order of `nodes`: the fewest hops that
        /// reach it from a start, 0 for a start; along a path, its hop.
        depths: list<u32>,
        edges: list<edge>,
        truncated: bool,
        next-cursor: option<cursor>,
    }

    variant query-result {
        rows(rows-page),
        graph(graph),
        groups(list<group>),
    }

    record search {
        %type: type-name,
        mode: search-mode,
        k: u32,
        cursor: option<cursor>,
        where: option<condition>,
        with-meta: bool,
        at: read-at,
    }

    record hit {
        %record: %record,
        score: f64,
    }

    record hits {
        hits: list<hit>,
        next-cursor: option<cursor>,
        ranked-by: string,
        axes: list<axis>,
    }

    /// One axis a search ranked by: `lexical` or `vector`, a vector
    /// axis's field, and, where the search fuses, the candidates it handed
    /// the fusion for this reader, up to the lake's `max_limit`, with the
    /// weight it ranked by and the model the caller named for its vector.
    record axis {
        axis: string,
        field: option<field-name>,
        candidates: option<u64>,
        weight: option<f64>,
        model: option<string>,
    }

    // ------------------------------------------------------------------
    // Describe
    // ------------------------------------------------------------------

    record lake-rights {
        review: bool,
        schema: bool,
        ingest: bool,
    }

    record type-rights {
        find: bool,
        get: bool,
        upsert: bool,
        retire: bool,
        /// The relations whose links the principal may write.
        link: list<relation-name>,
        /// The values the principal's grant admits records by; empty
        /// where it admits every record.
        only: list<field-value>,
    }

    record type-access {
        key: list<field-name>,
        valid-from: option<field-name>,
        valid-to: option<field-name>,
        searchable: bool,
        field-meta: bool,
    }

    record type-lineage {
        sourced: bool,
        /// Whether a source writes each of its records once.
        insert-only: bool,
        /// Who retires its records: only its verbs, or its authors too.
        retired-by: retired-by,
        view-of: option<type-name>,
    }

    record type-lifecycle {
        version: u32,
        schema-hash: string,
        /// The fields the lake keeps an order index for (its
        /// `sort_index.<type>` setting): a `find` ordered first by one of
        /// them reads its page, not the type.
        sorted: list<field-name>,
        /// The fields a `find` ordered first by and the lake answered by
        /// sorting the type, since it was opened where it answers.
        sorted-whole: list<sorted-whole>,
        /// The vector fields the lake asks an index for (its
        /// `vector_index.<type>` setting): a search over one of them
        /// answers the index's set and says `ranked_by: index`.
        indexed: list<field-name>,
        /// For a view: whether its records are kept (its
        /// `view_kept.<type>` setting) or computed at each read, and why.
        kept: option<kept>,
        /// The version of each value type a field shown uses: what the type
        /// accepts is keyed by `version`, `schema-hash` and these.
        value-types: list<tuple<value-type-name, u32>>,
    }

    /// A field ordered by sorting the whole type, and what it cost.
    record sorted-whole {
        field: field-name,
        pages: u64,
        millis: u64,
    }

    /// Whether a view's records are kept as its sources are written, or
    /// computed at each read.
    variant kept {
        kept,
        computed(not-kept),
    }

    /// Why a view is computed at each read: no setting asks for it; it
    /// cannot be kept (the case that says why, to a principal shown the
    /// view as declared); its records are not whole (the groups that are not
    /// exact for this reader); or its records are not kept at this
    /// position, or by this lake; or its reader is admitted only some
    /// records of it or of a type it reads.
    variant not-kept {
        not-asked,
        cannot-be-kept(option<said>),
        not-whole(u64),
        not-kept-here,
        only-some,
    }

    record field-description {
        name: field-name,
        %type: field-type,
        required: bool,
        authority: authority,
        access: access,
        derived: option<condition>,
        /// The declared function that computes it.
        function: option<string>,
        computed-at: option<computed-at>,
        depends-on: list<field-name>,
        on-input-change: on-input-change,
        /// The value it takes when its record comes to exist without one.
        initial: option<json>,
        filterable: bool,
        searchable: bool,
        sensitive: bool,
        erasable: bool,
        description: option<string>,
        label: option<string>,
        embed: option<embed-decl>,
        /// The host's own marks, to a principal who may see them.
        annotations: list<tuple<string, json>>,
    }

    record type-description {
        name: type-name,
        description: option<string>,
        label: option<string>,
        language: option<string>,
        /// The view as declared, to a principal who reads every source
        /// field it names or holds the schema grant.
        view: option<view-decl>,
        fields: list<field-description>,
        relations: list<relation-decl>,
        access: type-access,
        may: type-rights,
        verbs: list<verb-name>,
        lineage: type-lineage,
        lifecycle: type-lifecycle,
        /// The host's own marks, to a principal who may see them.
        annotations: list<tuple<string, json>>,
        /// From `describe-type`: the declaration of each value type the
        /// lifecycle's `value-types` names, in name order.
        value-types: list<value-type-decl>,
        /// The constraints whose fields its reader reads.
        constraints: list<constraint-decl>,
    }

    record verb-description {
        name: verb-name,
        on: type-name,
        scope: verb-scope,
        payload: list<field-description>,
        risk: risk,
        /// Exactly when `executor` is there.
        external: bool,
        executor: option<executor-description>,
        /// Whether it retires the record it is called on.
        retires: bool,
        description: option<string>,
    }

    /// The executor a verb that reaches outside the lake runs through, and
    /// whether the host binds it when the answer is made, at any position.
    record executor-description {
        name: string,
        bound: bool,
    }

    /// A lake setting: each one for the lake, and each one the lake
    /// holds for a type.
    record setting-value {
        key: string,
        value: option<json>,
        default: json,
        /// A host's setting's declaration, told to a holder of the schema
        /// grant and to one who may write it.
        declared: option<setting-decl>,
    }

    record lake-description {
        lake: lake-id,
        types: list<type-description>,
        verbs: list<verb-description>,
        value-types: list<value-type-decl>,
        /// Each value type by its version.
        value-type-versions: list<tuple<value-type-name, u32>>,
        /// Functions, triggers and object sets in force, each listed to a
        /// principal who reads every field it names or holds the schema
        /// grant.
        functions: list<function-decl>,
        triggers: list<trigger-decl>,
        object-sets: list<object-set-decl>,
        /// The listed lake settings, told to a holder of the schema
        /// grant.
        settings: list<setting-value>,
        may: lake-rights,
    }

    // ------------------------------------------------------------------
    // Replies: every read answers the position it was read at
    // ------------------------------------------------------------------

    record lake-description-reply { position: position, data: lake-description }
    record type-description-reply { position: position, data: type-description }
    record found-reply { position: position, data: found }
    record record-reply { position: position, data: %record }
    record query-result-reply { position: position, data: query-result }
    record hits-reply { position: position, data: hits }
    record proposals-reply { position: position, data: list<proposal> }
    record migration-report-reply { position: position, data: migration-report }

    /// What a change to the ontology would do, before it does it (062).
    record plan {
        report-id: string,
        at: position,
        /// Each type whose stored records it would change.
        types: list<migration-report>,
        value-types: list<value-type-report>,
        /// No section loses a value or breaks a constraint that refuses; a
        /// proposal's plan of declarations judges it on the records its
        /// proposer is told of.
        lossless: bool,
    }

    record plan-reply { position: position, data: plan }

    /// One field added to a type, as `add-field` adds it.
    record field-added {
        %type: type-name,
        field: field-decl,
    }

    /// A change to the ontology, as `plan` plans it and `enact` makes it.
    variant change {
        declare(list<declaration>),
        add-field(field-added),
        recompute(recomputed),
        migrate(migration),
        migrate-value-type(value-type-migration),
    }

    /// A value type's preflight: what its new declaration would refuse
    /// among the values stored under it.
    record value-type-report {
        value-type: value-type-name,
        from-version: u32,
        records-scanned: u64,
        fields: list<value-type-use>,
        misfits: u64,
        first: list<misfit>,
        fits: bool,
        report-id: string,
        /// The declarations and aging rules that may name a renamed value.
        conditions: list<string>,
        /// Whether one the reader is not shown may name one too.
        conditions-unshown: bool,
        /// The records the renames would leave breaking a constraint that admits.
        breaches: list<breach>,
    }

    /// One field that uses a value type, as its preflight found it.
    record value-type-use {
        %type: type-name,
        field: field-name,
        values-scanned: u64,
        misfits: u64,
        renamed: list<value-renamed>,
    }

    /// How many stored values one rename rewrites in a field.
    record value-renamed {
        %from: string,
        to: string,
        records: u64,
    }

    /// Where a stored value a new declaration would refuse is; never what.
    record misfit {
        %type: type-name,
        key: record-key,
        field: field-name,
    }

    record value-type-report-reply { position: position, data: value-type-report }

    // ------------------------------------------------------------------
    // Errors: the closed set every door answers with
    // ------------------------------------------------------------------

    record record-ref {
        %type: type-name,
        key: record-key,
    }

    variant missing {
        %type(type-name),
        %record(record-ref),
        verb(verb-name),
        function(string),
        proposal(proposal-id),
    }

    /// Why a call was refused. A refusal of `invalid`, `constraint`,
    /// `precondition`, `declined` or `unanswered` says its case
    /// (`lakelands_api::error::Case`) and where it is said.
    variant refusal {
        not-granted,
        wrong-door,
        verbs-only(list<verb-name>),
        reserved,
        invalid(said),
        constraint(said),
        precondition(said),
        too-deep(u32),
        too-large(u32),
        migration(migration-report),
        decided,
        unanswered(said),
        declined(said),
        out-of-range(position),
    }

    record refused {
        field: option<field-name>,
        reason: refusal,
    }

    record conflict {
        expected: version,
        actual: version,
    }

    /// A case of a closed set, as the crate's serde form writes it: the
    /// places it is said at as JSON text (a list, `[]` where it names
    /// none), its code, its parameters as JSON text (an object), and the
    /// sentence its parameters make. A code a caller does not know is
    /// rendered by its message.
    record said {
        at: string,
        code: string,
        params: string,
        message: string,
    }

    variant error {
        refused(refused),
        not-found(missing),
        conflict(conflict),
        /// The seam the call needs (`lakelands_api::error::Seam`).
        unbound(said),
        /// Why the lake cannot answer now
        /// (`lakelands_api::error::Situation`).
        unavailable(said),
    }

    /// What an ingest answers when it fails (lakelands#1043): the error,
    /// and, for a record of the stream that was refused, its place in the
    /// stream (from 0), the place of the first record of its window, from
    /// which nothing was written, and the record as its source named it.
    /// A refusal of the ingest itself, before any record, names none.
    record ingest-error {
        index: option<u64>,
        %from: option<u64>,
        %record: option<record-ref>,
        error: error,
    }

    // ------------------------------------------------------------------
    // The facade and the feed
    // ------------------------------------------------------------------

    record verification {
        %from: position,
        through: position,
        hash: digest,
    }

    /// What one `age` did: the date, each rule in name order, and the
    /// position after the last append.
    record age-report {
        date: timestamp,
        rules: list<rule-run>,
        transitions: u32,
        failed-guards: u32,
        refused: u32,
        position: position,
    }

    /// One aging rule's run: the rule's version, the records it moved,
    /// the guards that failed, the moves a constraint or the set ceiling
    /// refused (counted, and the first 16 listed), and why it was skipped
    /// if it was.
    record rule-run {
        rule: string,
        version: version,
        moved: u32,
        failed-guards: u32,
        refused: u32,
        refusals: list<refused-move>,
        skipped: option<string>,
    }

    /// A move of an aging run the lake refused: the record that stayed
    /// where it was, and the refusal.
    record refused-move {
        key: record-key,
        why: refusal,
    }

    /// What one purge retired, or its preflight says it would: the one
    /// type it was of where it named one, per type, the types it could
    /// not search, the position, what outside it refers into it, a
    /// preflight's id, and what its retirements set off across an edge
    /// beside the lake's `max_set_changes`.
    record purge-report {
        source: source-id,
        %type: option<type-name>,
        retired: u32,
        types: list<type-retired>,
        unsearched: list<type-name>,
        position: position,
        references: list<purge-reference>,
        moved: list<purge-moved>,
        report-id: string,
        set-off: u32,
        max-set-changes: u32,
    }

    /// The records a purge takes whose one field with a declared
    /// `initial` value an author had written: how many, and the first ten
    /// keys.
    record purge-moved {
        %type: type-name,
        field: field-name,
        records: u64,
        first: list<record-key>,
    }

    /// The live records outside a purge that refer into it over one
    /// relation: how many, and the first ten.
    record purge-reference {
        %type: type-name,
        relation: relation-name,
        records: u64,
        first: list<record-ref>,
    }

    /// How much of one embedding field is embedded, at the head.
    record vector-coverage {
        field: field-name,
        embedded: u64,
        due: u64,
    }

    /// What one compact measured of the projection's storage, in bytes,
    /// as the engine measures it, and the head it left unmoved.
    record compact-report {
        before: option<u64>,
        after: option<u64>,
        head: position,
    }

    /// The records a purge retired in one type.
    record type-retired {
        %type: type-name,
        retired: u32,
    }

    /// What one forgetting of a source erased, or its preflight says it
    /// would: the records and values it erases, the outputs, the records
    /// it retires and those it keeps co-owned, what is computed again,
    /// the values the log holds in plaintext (which refuse it), the
    /// events its rebuild folds and the time it is expected to hold the
    /// writer's lock, the position, the act's reclaim, and a preflight's id.
    record forget-report {
        source: source-id,
        types: list<forget-records>,
        fields: list<forget-field>,
        outputs: u64,
        retired: list<type-retired>,
        co-owned: list<forget-records>,
        recomputed: list<record-field>,
        views: list<type-name>,
        plaintext: u64,
        events: u64,
        expected-ms: u64,
        position: position,
        reclaimed: option<compact-report>,
        report-id: string,
    }

    /// Records of one type a forgetting reads: how many, and the first ten.
    record forget-records {
        %type: type-name,
        records: u64,
        first: list<record-key>,
    }

    /// The values one field of one type loses to a forgetting.
    record forget-field {
        %type: type-name,
        field: field-name,
        values: u64,
    }

    /// A field of a type.
    record record-field {
        %type: type-name,
        field: field-name,
    }

    record limits {
        default-limit: u32,
        max-limit: u32,
        max-depth: u32,
        max-reactive-depth: u32,
        commit-window-events: u32,
        max-graph-nodes: u32,
        max-offset: u32,
        max-set-changes: u32,
    }

    record feed-filter {
        /// Event kinds as the log spells them. Free strings, so a relay may
        /// name a kind a newer format adds; this format version's kinds are
        /// `lakelands_api::event::KINDS` (`docs/log-format.md`).
        kinds: list<string>,
        types: list<type-name>,
        /// Only events about records with these keys; all when empty.
        keys: list<record-key>,
    }

    record feed-batch {
        /// Each event as its canonical bytes (`docs/log-format.md` §1.2).
        events: list<json>,
        next: position,
        head: position,
    }
}
